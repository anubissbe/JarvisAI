# JarvisAI-0.1 Environment Configuration

# Core Configuration
WEBUI_NAME="JarvisAI-0.1 (Powered by Open WebUI)"
ENABLE_SELF_LEARNING=true
MEMORY_ARCHITECTURE=dual
CONFIDENCE_THRESHOLD=0.7

# Service URLs
OLLAMA_BASE_URL=http://ollama:11434
MEMORY_SERVICE_URL=http://memory-service:8000
LEARNING_SERVICE_URL=http://learning-service:8000
DOCUMENT_SERVICE_URL=http://document-service:8000

# Database Configuration
VECTOR_DB_URL=http://weaviate:8080
GRAPH_DB_URL=http://arangodb:8529
CHROMA_DB_URL=http://chromadb:8000
REDIS_URL=redis://redis:6379

# Database Credentials
ARANGO_ROOT_PASSWORD=jarvisai
# Change in production
ARANGO_USER=root

# API Keys (Add your keys in .env file, don't commit to git)
OPENWEATHER_API_KEY=your_openweather_api_key
NEWS_API_KEY=your_news_api_key

# Resource Limits
WEAVIATE_MEMORY=100GB
ARANGODB_MEMORY=50GB
CHROMADB_MEMORY=25GB
REDIS_MEMORY=10GB
OLLAMA_NUM_PARALLEL=4

# Security
JWT_SECRET=change_this_in_production
TOKEN_EXPIRY=24h

# Logging
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true