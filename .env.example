# JarvisAI Environment Configuration Template
# Copy this file to .env and configure with your values

# Core Application Settings
APP_NAME=JarvisAI
APP_VERSION=2025.1
ENVIRONMENT=development
DEBUG=true

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=3000
API_WORKERS=4

# Security Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth 2.1 Configuration (with PKCE)
OAUTH_CLIENT_ID=your-oauth-client-id
OAUTH_CLIENT_SECRET=your-oauth-client-secret
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
OAUTH_SCOPE=openid profile email

# Database Configuration
DATABASE_URL=postgresql://jarvis:password@localhost:5432/jarvis_db
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=password
POSTGRES_DB=jarvis_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Vector Database (Milvus) Configuration
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_GPU_ENABLED=true
MILVUS_COLLECTION_NAME=jarvis_vectors

# GPU Configuration
CUDA_VISIBLE_DEVICES=0,1
OLLAMA_GPUS=0,1
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_NUM_PARALLEL=2

# Model Configuration
EMBEDDING_MODEL=bge-m3
CHAT_MODEL=llama3.1:70b
THERAPEUTIC_MODEL=safespace-7b
MODEL_CACHE_SIZE=10GB

# Semantic Caching
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_TTL=3600
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.85

# Document Processing
DOCLING_ENABLED=true
PADDLEOCR_ENABLED=true
MAX_FILE_SIZE=100MB
SUPPORTED_FORMATS=pdf,docx,txt,md

# Object Storage (MinIO)
MINIO_ROOT_USER=jarvis
MINIO_ROOT_PASSWORD=password
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=jarvis-documents

# Monitoring & Observability
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true
LOKI_ENABLED=true
GRAFANA_ADMIN_PASSWORD=admin

# Performance Tuning
VECTOR_BATCH_SIZE=1000
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=300
MEMORY_LIMIT=256GB

# Feature Flags
THERAPEUTIC_MODE_ENABLED=true
MULTI_AGENT_ENABLED=true
DOCUMENT_PROCESSING_ENABLED=true
VOICE_MODE_ENABLED=false

# External APIs (Optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
BRAVE_API_KEY=

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# Development Settings
HOT_RELOAD=true
AUTO_MIGRATE=true
SEED_DATA=true

# Production Settings (Override in production)
# ENVIRONMENT=production
# DEBUG=false
# API_WORKERS=8
# HOT_RELOAD=false
# AUTO_MIGRATE=false
# SEED_DATA=false