# ====================
pids/
*.pid
*.seed
*.pid.lock
runtime/
sessions/

# ====================
# OPERATING SYSTEM
# ====================
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ====================
# LARGE BINARY FILES
# ====================
*.iso
*.dmg
*.tar.gz
*.zip
*.7z
*.rar
*.tar.xz
*.tar.bz2

# ====================
# JUPYTER NOTEBOOKS
# ====================
.ipynb_checkpoints/
*.ipynb

# ====================
# DOCUMENTATION BUILD
# ====================
site/
_site/
docs/_build/
docs/build/

# ====================
# INFRASTRUCTURE
# ====================
