# JarvisAI .gitignore - Comprehensive Data Protection

# ====================
# SECURITY & SECRETS
# ====================
.env*
*.env
secrets/
vault-data/
*.key
*.pem
*.p12
*.pfx
*.keystore
*.jks
*.crt
*.cert
*.ca-bundle
*.ca-crt
id_rsa*
ssh_key*
jwt-key*
oauth-*
api-key*
token*
credentials*
*.credentials
*-secret*
*secret*
password*
*.pwd

# ====================
# DEVELOPMENT FILES
# ====================
# IDEs and editors
.vscode/
.idea/
*.swp
*.swo
*~
.vim/
.emacs.d/
*.sublime-workspace
*.sublime-project

