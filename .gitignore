*.tfstate
*.tfstate.*
.terraform/
.terraformrc
terraform.rc
terraform.tfvars
*.auto.tfvars

# Kubernetes
*.kubeconfig
kube-config
.kube/

# Ansible
*.retry
.vault_pass

# ====================
# PERSONAL FILES
# ====================
