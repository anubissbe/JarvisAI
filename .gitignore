*idea*.txt
*notes*.md
*scratch*.txt
*todo*.txt
personal/
private/
drafts/

# ====================
# PACKAGE MANAGERS
# ====================
# Keep package-lock.json but ignore others
yarn.lock
pnpm-lock.yaml

# ====================
# MISC
# ====================
.history/
.vscode-test/
.vs/

